rules_version = '2';

// Classifiche dei giochi. Accesso solo anonimo (Firebase Auth); ognuno scrive
// solo i propri documenti e solo con un nome che ha "prenotato" in names/.
// Non provano che le partite siano oneste: limitano chi scrive cosa.
service cloud.firestore {
  match /databases/{db}/documents {
    function signedIn() { return request.auth != null; }
    function owner(uid) { return signedIn() && request.auth.uid == uid; }
    // il nome scritto nel documento deve essere quello prenotato da questo utente
    function ownName() {
      return request.resource.data.name is string
          && get(/databases/$(db)/documents/names/$(request.resource.data.name.lower())).data.uid == request.auth.uid;
    }

    // un nome per volta, mai due uguali: "create" fallisce se il documento esiste già
    match /names/{name} {
      allow read: if signedIn();
      // un nome nuovo si crea solo insieme alla scrittura di limits/{uid} (vedi sotto)
      allow create: if signedIn()
          && name.matches('^[^/]{3,16}$')
          && request.resource.data.keys().hasOnly(['uid'])
          && request.resource.data.uid == request.auth.uid
          && getAfter(/databases/$(db)/documents/limits/$(request.auth.uid)).data.changed == request.time;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    // limite dei cambi di nome: la prima scelta e il primo cambio sono liberi,
    // poi un cambio ogni 30 giorni (renames conta i cambi già fatti)
    match /limits/{uid} {
      allow read: if owner(uid);
      allow create: if owner(uid)
          && request.resource.data.keys().hasOnly(['changed', 'renames'])
          && request.resource.data.changed == request.time
          && request.resource.data.renames == 0;
      allow update: if owner(uid)
          && request.resource.data.keys().hasOnly(['changed', 'renames'])
          && request.resource.data.changed == request.time
          && request.resource.data.renames == resource.data.renames + 1
          && (resource.data.renames == 0 || request.time >= resource.data.changed + duration.value(30, 'd'));
    }

    // profilo: lo legge e lo scrive solo il proprietario
    match /players/{uid} {
      allow read: if owner(uid);
      allow create, update: if owner(uid) && ownName() && request.resource.data.trophies is int
          && request.resource.data.trophies >= 0 && request.resource.data.trophies <= 1000;
      allow delete: if owner(uid);
    }

    // righe della classifica settimanale: le leggono tutti i giocatori
    match /weeks/{week}/players/{uid} {
      allow read: if signedIn();
      allow create, update: if owner(uid) && ownName()
          && request.resource.data.games is int && request.resource.data.games >= 0 && request.resource.data.games <= 30
          && request.resource.data.ch is int && request.resource.data.ch >= 0 && request.resource.data.ch <= 500;
      allow delete: if owner(uid);
    }
  }
}
